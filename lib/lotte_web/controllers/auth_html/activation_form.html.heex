<Layouts.flash_group flash={@flash} />
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <h1 class="text-3xl font-bold text-secondary-900 mb-2">Activate your account</h1>
    <p class="text-secondary-700 mb-6">Set a password and accept the terms to finish.</p>

    <form action={~p"/activate/#{@token}"} method="post" class="space-y-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

      <div>
        <label class="label" for="activation_password">Password</label>
        <input
          type="password"
          id="activation_password"
          name="activation[password]"
          minlength="8"
          required
          data-testid="activation-password"
          class="input input-bordered w-full"
        />
        <%= for msg <- @errors[:password] || [] do %>
          <p class="text-sm text-error mt-1">{msg}</p>
        <% end %>
      </div>

      <div>
        <label class="label" for="activation_password_confirmation">Confirm password</label>
        <input
          type="password"
          id="activation_password_confirmation"
          name="activation[password_confirmation]"
          minlength="8"
          required
          data-testid="activation-password-confirmation"
          class="input input-bordered w-full"
        />
        <%= for msg <- @errors[:password_confirmation] || [] do %>
          <p class="text-sm text-error mt-1">{msg}</p>
        <% end %>
      </div>

      <label class="flex gap-2 items-start">
        <input type="hidden" name="activation[accept_terms]" value="false" />
        <input
          type="checkbox"
          name="activation[accept_terms]"
          value="true"
          data-testid="activation-accept-terms"
          class="checkbox mt-1"
        />
        <span class="text-sm">
          I accept the <a href="#" class="link link-primary">Terms</a>
        </span>
      </label>
      <%= for msg <- @errors[:accept_terms] || [] do %>
        <p class="text-sm text-error">{msg}</p>
      <% end %>

      <label class="flex gap-2 items-start">
        <input type="hidden" name="activation[accept_privacy]" value="false" />
        <input
          type="checkbox"
          name="activation[accept_privacy]"
          value="true"
          data-testid="activation-accept-privacy"
          class="checkbox mt-1"
        />
        <span class="text-sm">
          I accept the <a href="#" class="link link-primary">Privacy Policy</a>
        </span>
      </label>
      <%= for msg <- @errors[:accept_privacy] || [] do %>
        <p class="text-sm text-error">{msg}</p>
      <% end %>

      <button type="submit" data-testid="activation-submit" class="btn btn-primary w-full">
        Activate
      </button>
    </form>
  </div>
</div>
