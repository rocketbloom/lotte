<Layouts.flash_group flash={@flash} />
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <h1 class="text-3xl font-bold text-secondary-900 mb-2">Get started with Lotte</h1>
    <p class="text-secondary-700 mb-6">Enter your email to start the demo.</p>

    <form action={~p"/signup"} method="post" class="space-y-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input
        type="email"
        name="email"
        value={@email}
        placeholder="you@yourcompany.com"
        required
        autofocus
        data-testid="signup-email-input"
        class="input input-bordered w-full"
      />
      <%= if @error do %>
        <p class="text-sm text-error" data-testid="signup-error">{@error}</p>
      <% end %>
      <button
        type="submit"
        data-testid="signup-submit"
        class="btn btn-primary w-full"
      >
        Continue
      </button>
    </form>

    <p class="text-sm text-secondary-600 mt-6">
      Already activated? <.link navigate={~p"/login"} class="link link-primary">Sign in</.link>.
    </p>
  </div>
</div>
