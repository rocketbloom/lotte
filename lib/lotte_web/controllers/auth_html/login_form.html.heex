<Layouts.flash_group flash={@flash} />
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <h1 class="text-3xl font-bold text-secondary-900 mb-2">Sign in</h1>

    <form action={~p"/login"} method="post" class="space-y-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input
        type="email"
        name="email"
        value={@email}
        placeholder="you@yourcompany.com"
        required
        autofocus
        data-testid="login-email"
        class="input input-bordered w-full"
      />
      <input
        type="password"
        name="password"
        placeholder="Password"
        required
        data-testid="login-password"
        class="input input-bordered w-full"
      />
      <%= if @error do %>
        <p class="text-sm text-error" data-testid="login-error">{@error}</p>
      <% end %>
      <button type="submit" data-testid="login-submit" class="btn btn-primary w-full">
        Sign in
      </button>
    </form>

    <p class="text-sm text-secondary-600 mt-6">
      New here? <.link navigate={~p"/signup"} class="link link-primary">Get started</.link>.
    </p>
  </div>
</div>
