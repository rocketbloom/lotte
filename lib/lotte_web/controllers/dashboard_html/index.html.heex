<Layouts.flash_group flash={@flash} />
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="max-w-xl text-center">
    <h1 class="text-3xl font-bold text-secondary-900 mb-4">Welcome, {@user.email}</h1>
    <p class="text-secondary-700 mb-2" data-testid="dashboard-user-email">{@user.email}</p>
    <%= if @user.confirmed_at do %>
      <p class="text-success" data-testid="dashboard-status">Your account is activated.</p>
    <% else %>
      <p class="text-warning" data-testid="dashboard-status">
        Activation email sent. Check your inbox to finish setting your password.
      </p>
    <% end %>

    <p class="mt-6">
      <.link
        href={~p"/logout"}
        method="delete"
        class="link link-primary"
        data-testid="logout-link"
      >
        Sign out
      </.link>
    </p>
  </div>
</div>
