<Layouts.flash_group flash={@flash} />
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <h1 class="text-3xl font-bold text-secondary-900 mb-2">What's your company called?</h1>
    <p class="text-secondary-700 mb-6">
      We'll use this throughout Lotte. You can change it later.
    </p>

    <form action={~p"/onboarding/company"} method="post" class="space-y-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input
        type="text"
        name="company[name]"
        value={@name}
        placeholder="Acme Paramedical Practice"
        required
        autofocus
        data-testid="onboarding-company-name"
        class="input input-bordered w-full"
      />
      <%= if @error do %>
        <p class="text-sm text-error" data-testid="onboarding-error">{@error}</p>
      <% end %>
      <button type="submit" data-testid="onboarding-submit" class="btn btn-primary w-full">
        Continue
      </button>
    </form>
  </div>
</div>
