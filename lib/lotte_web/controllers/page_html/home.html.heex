<Layouts.flash_group flash={@flash} />
<div class="min-h-screen bg-gradient-to-br from-white via-primary-50 to-secondary-100 flex items-center justify-center px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl w-full">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-5xl sm:text-6xl font-bold text-secondary-900 mb-4">
        Lotte
      </h1>
      <p class="text-xl text-secondary-700 font-light italic">
        Your AI-powered paramedical assistant
      </p>
    </div>

    <!-- Main Card -->
    <div class="bg-white rounded-2xl shadow-2xl p-8 sm:p-12 border-2 border-primary-100">
      <div class="mb-8">
        <p class="text-lg text-secondary-800 leading-relaxed">
          Meet <span class="font-semibold text-primary-600">Lotte</span>, an intelligent AI agent designed to assist paramedical practices with patient support and appointment management.
        </p>
      </div>

      <!-- Features Grid -->
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="flex gap-4">
          <div class="text-2xl">💬</div>
          <div>
            <h3 class="font-semibold text-secondary-900 mb-1">24/7 Chat Support</h3>
            <p class="text-sm text-secondary-600">Instant responses to patient inquiries</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-2xl">📅</div>
          <div>
            <h3 class="font-semibold text-secondary-900 mb-1">Smart Appointments</h3>
            <p class="text-sm text-secondary-600">Efficient scheduling and reminders</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-2xl">🔒</div>
          <div>
            <h3 class="font-semibold text-secondary-900 mb-1">Secure & HIPAA Ready</h3>
            <p class="text-sm text-secondary-600">Patient data protection first</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="text-2xl">⚡</div>
          <div>
            <h3 class="font-semibold text-secondary-900 mb-1">Always Learning</h3>
            <p class="text-sm text-secondary-600">Powered by advanced AI</p>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button class="btn btn-primary btn-lg">
          Start Demo
        </button>
        <button class="btn btn-outline btn-secondary btn-lg">
          Learn More
        </button>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-12">
      <p class="text-sm text-secondary-600">
        Built with <span class="text-accent">❤</span> by RocketBloom
      </p>
      <p class="text-xs text-secondary-500 mt-2">
        "Trust the process" — Helping practices focus on patient care
      </p>
    </div>
  </div>
</div>
