#!/bin/sh
# This file is sourced before the start command is executed
# You can use it to set environment variables that will be used by the application

ip=$(hostname -I 2>/dev/null | awk '{print $1}')
if [ -z "$ip" ]; then
  ip=$(hostname -i 2>/dev/null || echo "127.0.0.1")
fi
export RELEASE_NODE="<%= @release.name %>@${ip}"
